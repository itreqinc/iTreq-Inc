# Frontend (Vite) — copy to .env.local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Auth bypass (fake local role, no session). Prefer false + DEV_AUTH_SWITCHER for real tests.
VITE_AUTH_BYPASS=false

# Local seed-user picker on /login + floating Switch user (real sessions via Edge impersonate).
# Also requires Edge secrets: ALLOW_DEV_IMPERSONATE=true, APP_ENV=development
# Never set true in production builds.
VITE_DEV_AUTH_SWITCHER=true

# --- Supabase Edge secrets (set via dashboard / `supabase secrets set`) ---
# ALLOW_DEV_IMPERSONATE=true
# APP_ENV=development
# AUTH_SMS_STUB=true
# RESEND_API_KEY=
# OPS_EMAIL_FROM=iTreq Inc <no-reply@itreqinc.com>
