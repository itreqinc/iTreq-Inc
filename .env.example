# Copy to .env.local and fill in values from Supabase:
# Project Settings → API
#
# Project URL: https://gtsjiqbohbgzwqfqkgyr.supabase.co
# Use the anon (public) key — never put the service_role key in the frontend.

VITE_SUPABASE_URL=https://gtsjiqbohbgzwqfqkgyr.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Ops auth bypass (Phases 0–5). MUST be false/absent on production.
# true = skip OTP login; fake staff/client user for faster testing.
VITE_AUTH_BYPASS=true

# Public site URL (for logo in emailed quotations/invoices). Example: https://www.itreqinc.com
# VITE_PUBLIC_SITE_URL=https://www.itreqinc.com

# Optional: Supabase Edge Function `send-billing-document` (deploy + secrets):
# RESEND_API_KEY, OPS_EMAIL_FROM (e.g. iTreq Inc <billing@your-verified-domain.com>)
