# Frontend (Vite) — copy to .env.local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Auth bypass (ops UI without real login). Must be false when testing real auth.
VITE_AUTH_BYPASS=false

# Local-only floating user switcher (also requires Edge secret ALLOW_DEV_IMPERSONATE=true).
# Never set true in production builds. Blocked when APP_ENV=production on the Edge Function.
VITE_DEV_AUTH_SWITCHER=true

# --- Supabase Edge secrets (set via dashboard / `supabase secrets set`) ---
# ALLOW_DEV_IMPERSONATE=true
# APP_ENV=development
# AUTH_SMS_STUB=true
# RESEND_API_KEY=
# OPS_EMAIL_FROM=iTreq Inc <no-reply@itreqinc.com>
